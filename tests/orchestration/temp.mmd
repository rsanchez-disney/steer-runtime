graph TB
    subgraph "Clients"
        UI[wdpr-payment-controls-client<br/>Angular SPA]
        Downstream[Downstream Payment Systems]
    end

    subgraph "Traffic Layer"
        ALB[Application Load Balancer<br/>Path-Based Routing]
    end

    subgraph "Microservices Layer"
        subgraph "wdpr-refund-controls-api"
            RC_API[REST API<br/>Express/Fastify]
            RC_Export[Export Engine<br/>Async Job Worker]
            RC_Biz[Refund Business Logic]
            RC_Events[Event Publisher]
        end

        subgraph "wdpr-validation-controls-api"
            VC_API[REST API<br/>Express/Fastify]
            VC_Engine[Rules Engine]
            VC_Biz[Validation Business Logic]
            VC_Events[Event Publisher]
        end
    end

    subgraph "Event Bus"
        SNS[AWS SNS Topics]
        SQS_R[SQS: Refund Events Queue]
        SQS_V[SQS: Validation Events Queue]
        DLQ[Dead Letter Queues]
    end

    subgraph "Persistence Layer"
        Backend[wdpr-config-services<br/>Java - DynamoDB/MariaDB]
        S3[AWS S3<br/>Export Files]
        Redis[ElastiCache Redis<br/>Rules + Config Cache]
    end

    UI --> ALB
    Downstream --> ALB
    ALB -->|"/api/refunds/*, /api/exports/*, /api/configs/*"| RC_API
    ALB -->|"/api/validations/*, /api/rules/*"| VC_API

    RC_API --> RC_Biz
    RC_Biz --> RC_Export
    RC_Biz --> Backend
    RC_Export --> S3
    RC_Export --> Backend
    RC_Events --> SNS
    RC_Biz --> Redis

    VC_API --> VC_Biz
    VC_Biz --> VC_Engine
    VC_Biz --> Backend
    VC_Engine --> Redis
    VC_Events --> SNS

    SNS --> SQS_R
    SNS --> SQS_V
    SQS_R --> RC_Biz
    SQS_V --> VC_Biz
    SQS_R -.-> DLQ
    SQS_V -.-> DLQ