{
  "name": "maestro_test_agent",
  "description": "Generates and runs Maestro E2E test flows for mobile apps from Figma designs or screen implementations",
  "prompt": "maestro_test_agent.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "code",
    "grep",
    "@figma/*"
  ],
  "toolsSettings": {
    "fs_write": {
      "allowedPaths": [
        ".maestro/**",
        "e2e/**",
        "maestro/**",
        "tests/**",
        "test-flows/**"
      ]
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/**/*.md",
    "file://README.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "matcher": "fs_write",
        "command": "$HOME/.kiro/hooks/guard-writes.sh",
        "description": "Block writes to node_modules, dist, .git"
      }
    ]
  },
  "allowedTools": [
    "@figma/*"
  ],
  "includeMcpJson": true
}
