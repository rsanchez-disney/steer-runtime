{
  "name": "chg_analyzer_agent",
  "description": "Analyzes ServiceNow production change requests end-to-end: extracts CTASKs, verifies Cloud deployments, analyzes code changes via GitHub/Gitlab, validates JIRA fix versions, and generates compliance reports",
  "prompt": "prompts/chg_analyzer_agent.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "grep",
    "thinking"
  ],
  "resources": [
    "file://.kiro/context/sustainment_guidelines.md",
    "file://.kiro/context/servicenow_reference.md",
    "file://.kiro/context/chg_analysis_patterns.md",
    "file://.kiro/context/_dynamic/catalog-index.md"
  ],
  "allowedTools": [
    "@jira/*",
    "@github/*",
    "@servicenow/*",
    "@compass/*"
  ],
  "includeMcpJson": true,
  "hooks": {
    "agentSpawn": [
      {
        "command": "$HOME/.kiro/hooks/git-context.sh",
        "description": "Inject git branch and status"
      },
      {
        "command": "$HOME/.kiro/hooks/catalog-index.sh",
        "description": "Load managed services catalog index"
      }
    ],
    "preToolUse": [
      {
        "matcher": "execute_bash",
        "command": "$HOME/.kiro/hooks/warn-destructive.sh",
        "description": "Warn on destructive commands"
      }
    ]
  },
  "welcomeMessage": "CHG Analyzer ready. Provide a CHG number and I'll analyze the change request, verify deployments, and generate a compliance report."
}
